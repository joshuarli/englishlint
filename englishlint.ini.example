# Copy this file to englishlint.ini in the project root.
[lint]
# Files use descriptive mode unless a heading or directive selects procedural mode.
default_type = descriptive
procedural_limit = 20
descriptive_limit = 25
# Comma-separated headings that imply procedural text.
procedural_headings = install, setup, configure, troubleshooting, migration, deploy
# Ignore rules globally, for example: ignore_rules = ENG014
ignore_rules =
# Ignore words globally, for example: ignore_words = robust, widget
ignore_words =

# Set the preferred term for a concept. This also makes ENG010 actionable.
[glossary]
# check = make sure
# config = configuration
# delete = delete


# Profiles let a repository apply different rules to different Markdown classes.
# Paths use / separators. A trailing /** matches all descendants.
[profile.guidance]
paths = README.md, AGENTS.md, NORTH-STAR.md, FACTORY.md, CTO.md, docs/**, roles/**, runtime/**
ignore_rules = ENG011, ENG014
severity = ENG001:error, ENG003:error, ENG004:error, ENG012:warning

[profile.contracts]
paths = tickets/**, evals/**, templates/**
ignore_rules = ENG001, ENG004, ENG009, ENG011, ENG013, ENG014
severity = ENG003:warning, ENG005:warning, ENG006:warning
